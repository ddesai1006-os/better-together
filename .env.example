# Claude — powers Brain Dump interpretation, photo reading, and smart assignment.
# Without it the app runs on a simple offline rules engine.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Signs session cookies. Use a long random string in production: `openssl rand -base64 32`
SESSION_SECRET=

# Durable storage — Supabase (preferred) or Upstash Redis. The Vercel Marketplace
# integrations set these automatically. For Supabase, also run supabase/setup.sql once.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   (server-only — never expose to the browser)
#
# Without them, data is stored in .data/db.json locally (and in ephemeral /tmp on Vercel).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Timezone for the seeded demo household
# DEMO_TIMEZONE=America/New_York
